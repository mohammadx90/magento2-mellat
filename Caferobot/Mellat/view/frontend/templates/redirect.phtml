<?php
/** @var \Caferobot\Mellat\Block\Redirect $block */
$refId = $block->getRefId();
$mobile = $block->getMobile();
$url = $block->getBankUrl();
?>

<?php if ($refId): ?>
    <div class="redirect-container">
        <div class="loader"></div>
        <p>در حال انتقال به درگاه بانک ملت...</p>
        <p>لطفا شکیبا باشید.</p>

        <form id="mellat-form" method="post" action="<?= $block->escapeUrl($url) ?>">
            <input type="hidden" name="RefId" value="<?= $block->escapeHtmlAttr($refId) ?>">
            <input type="hidden" name="MobileNo" value="<?= $block->escapeHtmlAttr($mobile) ?>">
        </form>
    </div>

    <script type="text/javascript">
        // Direct vanilla JS submission (instant)
        document.getElementById('mellat-form').submit();
    </script>
<?php else: ?>
    <div class="redirect-container error">
        <?= __('Error initiating payment. Resfreshing the page may fix it.') ?>
    </div>
<?php endif; ?>


